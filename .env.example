# ---------------------------------------------------------------------------
# jira-clone root environment file
# Copy this file to `.env` (same directory) before running docker compose:
#   cp .env.example .env
# Then edit the values below. `.env` is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=jira_clone
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=jira_clone
# Used by the server container to connect to the postgres container.
DATABASE_URL=postgresql://jira_clone:change-me-strong-password@postgres:5432/jira_clone?schema=public

# --- Server -------------------------------------------------------------
NODE_ENV=production
PORT=4000
# Required in production. Generate a long random secret, e.g.:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
# Comma-separated list of origins allowed to call the API (CORS). Use your
# public client URL in production, e.g. https://tracker.example.com
CORS_ORIGIN=http://localhost:5173

# --- First-run admin account -------------------------------------------
# Used by the seed script on first boot only. CHANGE THE PASSWORD AFTER FIRST LOGIN.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# --- SMTP bootstrap defaults ---------------------------------------------
# These are used only if no SmtpSettings row has been configured yet from the
# in-app Admin Settings screen. Once an admin saves SMTP settings in the UI,
# the database values take precedence over everything below.
# Leave blank to disable outbound email (notifications will simply be
# recorded in-app and email sending will be skipped silently).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Open Issue Tracker <no-reply@example.com>"

# --- Attachments (local-disk storage) --------------------------------------
# Directory (relative to the server process, or absolute) where uploaded issue
# attachments are stored. In the docker-compose setup this should be a
# mounted volume so uploads survive container recreation. Not suitable for
# multiple server replicas without shared/networked storage (e.g. NFS, S3).
UPLOAD_DIR=uploads
MAX_ATTACHMENT_MB=25

# --- Client build-time config ---------------------------------------------
# Base URL the client uses to reach the API. In the docker-compose setup the
# nginx container proxies /api to the server, so this can stay relative.
VITE_API_URL=/api
