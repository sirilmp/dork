# Server-specific environment file for local development (outside Docker).
# For the Docker Compose setup, use the root `.env` file instead — see
# ../../.env.example.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://jira_clone:jira_clone@localhost:5432/jira_clone?schema=public
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Open Issue Tracker <no-reply@example.com>"
