generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  ADMIN
  MEMBER
}

enum ProjectRole {
  ADMIN
  MEMBER
  VIEWER
}

enum IssueType {
  EPIC
  STORY
  TASK
  BUG
  SUBTASK
}

// The three buckets that burndown / sprint-complete / "is this done" logic
// must reason about. Per-project WorkflowStatus rows are admin-defined and
// freely named/renamed, but every status maps to exactly one of these
// categories — so logic that needs to know "is this issue done" always
// checks `status.category === 'DONE'`, never a status's name or id.
enum StatusCategory {
  TODO
  IN_PROGRESS
  DONE
}

enum IssuePriority {
  LOWEST
  LOW
  MEDIUM
  HIGH
  HIGHEST
}

enum IssueLinkType {
  BLOCKS
  RELATES_TO
  DUPLICATES
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum NotificationType {
  ISSUE_ASSIGNED
  COMMENT_MENTION
  COMMENT_ADDED
  ISSUE_STATUS_CHANGED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  CHECKBOX
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  role         SystemRole @default(MEMBER)
  // Null means active. A deactivated user is blocked from logging in and is
  // hidden from assignee-picker dropdowns going forward, but their historical
  // issues/comments/activity are left intact with their name still shown —
  // see the admin-users module for why this is deliberately not a hard delete.
  deactivatedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leadingProjects   Project[]       @relation("ProjectLead")
  memberships       ProjectMember[]
  reportedIssues    Issue[]         @relation("ReportedIssues")
  assignedIssues    Issue[]         @relation("AssignedIssues")
  comments          Comment[]
  activityLogs      ActivityLog[]
  notifications     Notification[]
  teamMemberships   TeamMember[]
  sentInvites       Invite[]        @relation("InvitedBy")
  starredProjects   StarredProject[]
  attachments       Attachment[]

  @@index([email])
}

model Invite {
  id            String       @id @default(uuid())
  email         String
  // Stored as a raw opaque random token rather than hashed: an invite token is
  // a short-lived (7 day), single-purpose, revocable capability — not a
  // reusable credential like a password — and the public lookup endpoint
  // needs to resolve it directly. See admin-users module notes for the
  // full tradeoff vs. hashing like bcrypt does for passwords.
  token         String       @unique
  invitedById   String
  invitedBy     User         @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  role          SystemRole   @default(MEMBER)
  status        InviteStatus @default(PENDING)
  expiresAt     DateTime
  createdAt     DateTime     @default(now())
  acceptedAt    DateTime?

  @@index([email])
  @@index([status])
}

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members TeamMember[]
}

model TeamMember {
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@unique([teamId, userId])
  @@index([userId])
}

model Project {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  leadId      String?
  lead        User?    @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Next sequential issue number to assign within this project (PROJ-1, PROJ-2, ...).
  issueCounter Int @default(0)

  members ProjectMember[]
  issues  Issue[]
  labels  Label[]
  sprints Sprint[]
  starredBy StarredProject[]
  workflowStatuses    WorkflowStatus[]
  workflowTransitions WorkflowTransition[]
  customFieldDefinitions CustomFieldDefinition[]

  @@index([leadId])
}

// Project-admin-defined custom field on this project's issues. `options` is
// only meaningful for SELECT (a JSON array of string choices); other types
// ignore it.
model CustomFieldDefinition {
  id        String          @id @default(uuid())
  projectId String
  name      String
  fieldType CustomFieldType
  options   Json?
  required  Boolean         @default(false)
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  project Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values  CustomFieldValue[]

  @@index([projectId, order])
}

// One issue's value for one custom field definition. `value`'s JSON shape
// depends on the definition's fieldType: string for TEXT/SELECT, number for
// NUMBER, ISO date string for DATE, boolean for CHECKBOX. A missing row means
// "unset" rather than storing an explicit null, so the client always derives
// the full set of fields (including unset ones) from the project's
// definitions joined with whatever value rows exist for the issue.
model CustomFieldValue {
  id               String   @id @default(uuid())
  issueId          String
  fieldDefinitionId String
  value            Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  issue           Issue                 @relation(fields: [issueId], references: [id], onDelete: Cascade)
  fieldDefinition CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([issueId, fieldDefinitionId])
  @@index([fieldDefinitionId])
}

// A project's configurable workflow: the ordered set of statuses its issues
// can be in. Exactly one status per project should have isDefault = true
// (the status new issues are created with); enforced in application code,
// not a DB constraint.
model WorkflowStatus {
  id        String         @id @default(uuid())
  projectId String
  name      String
  category  StatusCategory
  order     Int
  color     String?
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues           Issue[]
  transitionsFrom  WorkflowTransition[] @relation("TransitionFrom")
  transitionsTo    WorkflowTransition[] @relation("TransitionTo")

  @@index([projectId, order])
}

// Optional per-project restriction on which status-to-status board moves are
// allowed. Semantics (see boards/workflow modules): a project with ZERO rows
// here has NO restrictions — any status can move to any other status, which
// is the default for every existing and newly created project. The moment a
// project has at least one row, moves are restricted to exactly the
// (fromStatusId -> toStatusId) pairs defined for it, plus every status is
// always implicitly allowed to "move" to itself (a no-op). `fromStatusId`
// null means "from any status" (e.g. a rule letting anything jump back to
// "To Do").
model WorkflowTransition {
  id           String   @id @default(uuid())
  projectId    String
  fromStatusId String?
  toStatusId   String
  createdAt    DateTime @default(now())

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStatus WorkflowStatus? @relation("TransitionFrom", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatus   WorkflowStatus  @relation("TransitionTo", fields: [toStatusId], references: [id], onDelete: Cascade)

  @@unique([projectId, fromStatusId, toStatusId])
}

model Sprint {
  id          String       @id @default(uuid())
  projectId   String
  name        String
  goal        String?
  status      SprintStatus @default(PLANNED)
  startDate   DateTime?
  endDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId, status])
}

// Backend-persisted starring (follows the account across devices, unlike the
// client's localStorage-only "Recent" list — see sidebar notes).
model StarredProject {
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@unique([userId, projectId])
  @@index([projectId])
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@unique([projectId, userId])
  @@index([userId])
}

model Issue {
  id          String        @id @default(uuid())
  projectId   String
  number      Int
  type        IssueType     @default(TASK)
  title       String
  // Plain-text fallback kept in sync (derived server-side from descriptionJson
  // on every save) for search/preview use — see descriptionJson for the
  // source of truth.
  description String?
  // Tiptap document JSON (source of truth for rendering). Stored as JSON
  // rather than HTML/markdown so the client fully controls the renderer and
  // no server-side HTML sanitization is needed to avoid stored XSS.
  descriptionJson Json?
  statusId    String
  priority    IssuePriority @default(MEDIUM)

  assigneeId String?
  reporterId String
  parentId   String?

  storyPoints Int?
  dueDate     DateTime?

  // Position within its status column on the kanban board (lower = earlier).
  // Not part of the original spec's field list but needed to support
  // within-column drag-and-drop reordering; defaults to insertion order.
  order Int @default(0)

  // Sprint the issue is planned into; null means it sits in the Backlog.
  sprintId String?
  // Position within the backlog list (separate from `order`, which is only
  // used for kanban-column position on the board).
  backlogOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Restrict: a status with issues still pointing at it cannot be deleted
  // (see workflow module's delete-status 409 handling).
  status   WorkflowStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  assignee User?   @relation("AssignedIssues", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter User    @relation("ReportedIssues", fields: [reporterId], references: [id], onDelete: Restrict)
  parent   Issue?  @relation("IssueChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children Issue[] @relation("IssueChildren")
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  labels        IssueLabel[]
  comments      Comment[]
  activityLogs  ActivityLog[]
  linksFrom     IssueLink[]   @relation("LinksFrom")
  linksTo       IssueLink[]   @relation("LinksTo")
  customFieldValues CustomFieldValue[]
  attachments   Attachment[]

  @@unique([projectId, number])
  @@index([projectId, statusId])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([parentId])
  @@index([sprintId])
}

model Label {
  id        String  @id @default(uuid())
  projectId String
  name      String
  color     String  @default("#6366f1")

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  IssueLabel[]

  @@unique([projectId, name])
}

model IssueLabel {
  issueId String
  labelId String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
}

model IssueLink {
  id            String        @id @default(uuid())
  issueId       String
  linkedIssueId String
  type          IssueLinkType

  issue       Issue @relation("LinksFrom", fields: [issueId], references: [id], onDelete: Cascade)
  linkedIssue Issue @relation("LinksTo", fields: [linkedIssueId], references: [id], onDelete: Cascade)

  @@unique([issueId, linkedIssueId, type])
}

model Comment {
  id        String   @id @default(uuid())
  issueId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

// A file uploaded to an issue. The actual bytes live on local disk (see the
// attachments module), named by a generated UUID — never the original
// filename — to avoid path-traversal and collision issues; this row is the
// only place the original name/mime/size are recorded.
model Attachment {
  id           String   @id @default(uuid())
  issueId      String
  uploadedById String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  createdAt    DateTime @default(now())

  issue      Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([issueId])
}

// Auto-recorded on field changes such as status/assignee transitions.
model ActivityLog {
  id        String   @id @default(uuid())
  issueId   String
  actorId   String
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor User  @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  payload   Json
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// Singleton row (id = "singleton") holding server-admin-configured branding.
model BrandingSettings {
  id           String   @id @default("singleton")
  productName  String   @default("Open Issue Tracker")
  logoUrl      String?
  faviconUrl   String?
  primaryColor String   @default("#2563eb")
  accentColor  String   @default("#7c3aed")
  updatedAt    DateTime @updatedAt
}

// Singleton row (id = "singleton") holding server-admin-configured SMTP settings.
// NOTE: `password` is stored in plaintext for this MVP. In a real deployment this
// column should be encrypted at rest (e.g. via application-level envelope
// encryption or a secrets manager) — isolate access behind the admin-only API
// and treat this as a TODO before handling real credentials.
model SmtpSettings {
  id          String   @id @default("singleton")
  host        String?
  port        Int      @default(587)
  username    String?
  password    String?
  fromAddress String?
  secure      Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}
